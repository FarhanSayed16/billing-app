DATABASE_URL=postgresql://user:password@localhost:5432/billpush
DIRECT_URL=postgresql://user:password@localhost:5432/billpush
JWT_SECRET=your-strong-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
REDIS_URL=redis://localhost:6379
S3_BUCKET_NAME=billpush-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
# Local only: allow fake S3 URLs. Never set true in production.
S3_MOCK=true
PORT=3000
ENABLE_GUEST_LOGIN=false
CORS_ORIGINS=http://localhost:3005,http://localhost:3000
# Optional path or filename for Firebase Admin credentials JSON
# FIREBASE_CREDENTIALS=./firebase-service-account.json
NODE_ENV=development
